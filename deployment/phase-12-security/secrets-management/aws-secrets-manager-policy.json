{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLaunchboardDatabaseSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:YOUR_AWS_REGION:YOUR_ACCOUNT_ID:secret:devops-launchboard/phase-12/database-*"
    }
  ]
}
