PROJECT_NAME=devops-launchboard
POSTGRES_DB=launchboard
POSTGRES_USER=launchboard
POSTGRES_PASSWORD=[DB_PASSWORD]
DATABASE_URL=postgresql+asyncpg://launchboard:[DB_PASSWORD]@launchboard-db:5432/launchboard
APP_ENV=production
CORS_ORIGINS=http://localhost:8080
SEED_DEMO_DATA=false
BACKEND_IMAGE=launchboard-backend:local
FRONTEND_IMAGE=launchboard-frontend:local
