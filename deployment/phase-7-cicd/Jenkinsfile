pipeline { agent any; environment { AWS_REGION='[REGION]'; AWS_ACCOUNT_ID='[AWS_ACCOUNT_ID]'; IMAGE_TAG="${env.GIT_COMMIT}"; REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com" } stages { stage('Test') { steps { sh 'deployment/phase-7-cicd/scripts/run-tests.sh' } } stage('Build') { steps { sh 'deployment/phase-3-docker/build-and-push.sh $AWS_ACCOUNT_ID $AWS_REGION $IMAGE_TAG' } } stage('Scan') { steps { sh 'deployment/phase-7-cicd/scripts/scan-image.sh $REGISTRY/launchboard-backend:$IMAGE_TAG' } } stage('Deploy') { steps { sh 'deployment/phase-7-cicd/scripts/deploy.sh $IMAGE_TAG' } } } }
