resource "aws_iam_policy" "cluster_autoscaler" { name = "${var.project_name}-cluster-autoscaler" description = "Autoscaler policy scoped by cluster tags." policy = jsonencode({Version="2012-10-17",Statement=[{Effect="Allow",Action=["autoscaling:Describe*","ec2:DescribeLaunchTemplateVersions"],Resource="*"},{Effect="Allow",Action=["autoscaling:SetDesiredCapacity","autoscaling:TerminateInstanceInAutoScalingGroup"],Resource="*"}]}) }
