# syntax=docker/dockerfile:1.7
# Builder stage installs dependencies into a virtual environment.
FROM python:3.12-alpine AS builder
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apk add --no-cache build-base libffi-dev postgresql-dev curl
WORKDIR /app
COPY backend/pyproject.toml backend/alembic.ini ./
COPY backend/app ./app
COPY backend/alembic ./alembic
RUN python -m venv /opt/venv && pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .
# Runtime stage keeps only runtime packages and runs as a non-root user.
FROM python:3.12-alpine AS runtime
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 APP_ENV=production SEED_DEMO_DATA=false
RUN apk add --no-cache libpq curl && addgroup -S app && adduser -S app -G app
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD curl -fsS http://127.0.0.1:8000/health || exit 1
CMD ["fastapi", "run", "app/main.py", "--host", "0.0.0.0", "--port", "8000"]
