# syntax=docker/dockerfile:1.7
# Builder stage compiles the Vite app.
FROM node:22-alpine AS builder
WORKDIR /app
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build
# Runtime stage serves static assets with Nginx as non-root.
FROM nginx:1.27-alpine AS runtime
RUN addgroup -S app && adduser -S app -G app && mkdir -p /tmp/nginx /var/cache/nginx /var/run && chown -R app:app /usr/share/nginx/html /var/cache/nginx /var/run /tmp/nginx
COPY deployment/phase-3-docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
USER app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
