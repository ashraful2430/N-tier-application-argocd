[Unit]
Description=DevOps LaunchBoard FastAPI backend
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
Type=simple
User=launchboard
Group=launchboard
WorkingDirectory=/opt/devops-launchboard/backend
EnvironmentFile=/etc/devops-launchboard/backend.env
ExecStart=/opt/devops-launchboard/backend/.venv/bin/fastapi run app/main.py --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/devops-launchboard/backend
[Install]
WantedBy=multi-user.target
